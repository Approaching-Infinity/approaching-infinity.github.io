---
import { getEpisodesNewestFirst } from '../lib/episodes';
import EpisodeRow from './EpisodeRow.astro';
const episodes = (await getEpisodesNewestFirst()).slice(0, 4);
---
<section class="episodes" id="episodes">
  <div class="wrap">
    <div class="ep-top">
      <div class="sec-head" style="margin:0">
        <span class="eyebrow reveal">The conversations</span>
        <h2 class="reveal">Latest episodes</h2>
      </div>
      <a class="btn btn-ghost reveal" href="/episodes/">All episodes &nbsp;&rarr;</a>
    </div>
    <div class="ep-list reveal">
      {episodes.map((ep) => (
        <EpisodeRow episode={ep} />
      ))}
    </div>
  </div>
</section>
