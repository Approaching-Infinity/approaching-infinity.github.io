---
import { getEpisodesNewestFirst } from '../lib/episodes';
const episodes = (await getEpisodesNewestFirst()).slice(0, 4);
---
<section class="episodes" id="episodes">
  <div class="wrap">
    <div class="ep-top">
      <div class="sec-head" style="margin:0">
        <span class="eyebrow reveal">The conversations</span>
        <h2 class="reveal">Latest episodes</h2>
      </div>
      <a class="btn btn-ghost reveal" href="/episodes/">All episodes &nbsp;&rarr;</a>
    </div>
    <div class="ep-list reveal">
      {episodes.map((ep) => (
        <a class="ep" href={`/episodes/${ep.id}/`}>
          <div class="ep-no">{ep.data.bonus ? 'Bonus' : ep.data.episodeNumber}</div>
          <div><div class="ep-title">{ep.data.title}</div>{ep.data.guest && <div class="ep-guest">with {ep.data.guest}</div>}</div>
          <div class="ep-play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></div>
        </a>
      ))}
    </div>
  </div>
</section>
