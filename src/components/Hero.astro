---
import { siteSupport } from '../config/site';

const { visible: showSupport } = siteSupport();
---
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-lines"></div>
    <div class="hero-inf">&#8734;</div>
  </div>
  <div class="wrap">
    <span class="eyebrow reveal">Podcast &nbsp;&middot;&nbsp; In service of a mission</span>
    <h1 class="reveal">Finance, technology<br>&amp; innovation.<br><span class="l2">Ideas that create opportunity.</span></h1>
    <p class="hero-sub reveal">Approaching Infinity brings founders, investors, operators and veterans together for useful conversations, while building toward three missions: reducing poverty, supporting veterans and improving financial literacy. Hosted by <b>Justin Roopnarine</b>.</p>
    <div class="hero-cta reveal">
      <a class="btn btn-red" href="#listen">&#9654;&nbsp; Listen now</a>
      <a class="btn btn-ghost" href="/resources/">Explore free resources</a>
    </div>
    {showSupport && <a class="hero-support reveal" href="/support/">Support the show <span aria-hidden="true">&rarr;</span></a>}
    <p class="hero-followup reveal"><a href="/contact/">Contact us</a><span aria-hidden="true"> · </span><a href="/newsletter/">Join the newsletter</a></p>
    <div class="hero-meta reveal">
      <span><i class="dot"></i> New episodes</span>
      <span>Founders &middot; Investors &middot; Veterans</span>
      <span>Spotify &middot; Apple &middot; YouTube</span>
    </div>
  </div>
</section>

<style>
  .hero-support { display: inline-flex; align-items: center; gap: .5rem; min-height: 44px; margin-top: .55rem; color: #ff777c; font-weight: 650; }
  .hero-support:hover { text-decoration: underline; text-underline-offset: .2em; }
  .hero-support:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
</style>
