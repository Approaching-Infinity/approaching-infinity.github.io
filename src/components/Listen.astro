---
import { listeningPlatforms, listeningHub } from '../data/platforms.mjs';
---
<section class="listen" id="listen">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="eyebrow">Listen everywhere</span>
      <h2>Pick your platform</h2>
      <p>Follow the show wherever you already listen.</p>
    </div>
    <ul class="plat-grid reveal" aria-label="Listening platforms">
      {listeningPlatforms.map(platform => <li>
        <a class="plat" href={platform.url} target="_blank" rel="noopener" aria-label={`${platform.name} — ${platform.action} (opens in a new tab)`}>
          <span class:list={['plat-icon', `plat-icon--${platform.id}`]} aria-hidden="true">
            <img src={platform.icon} alt="" width="64" height="64" loading="lazy" decoding="async" />
          </span>
          <span class="plat-copy"><span class="plat-name">{platform.name}</span><span class="plat-sub">{platform.action}</span></span>
          <img class="plat-arrow" src="/icons/platforms/arrow-right.svg" alt="" width="28" height="28" aria-hidden="true" />
        </a>
      </li>)}
    </ul>
    <div class="hub reveal">
      <span class="eyebrow hub-label">Hub</span>
      <a class="hub-link" href={listeningHub} target="_blank" rel="noopener" aria-label="All listening links (opens in a new tab)">All listening links <img src="/icons/platforms/arrow-right.svg" alt="" width="20" height="20" aria-hidden="true" /></a>
    </div>
  </div>
</section>
