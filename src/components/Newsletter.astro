---
import { siteForms } from '../config/site';
const config = siteForms();
const { standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
---
<section class="news" id="newsletter"><div class="wrap">
  <span class="eyebrow">Approaching Infinity Notes</span>
  <Heading>Conversations worth carrying forward.</Heading>
  <p>Episode highlights, practical resources, mission progress and confirmed public events. One place to follow the work.</p>
  {config.newsletter ? <>
    {config.review && <p class="review-inline">Demo signup: fictional email only. No subscription is created.</p>}
    <form action={config.newsletter} method="POST" class="newsletter-form">
      <div class="field"><label for="newsletter-email">Email address</label><input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" /></div>
      <label class="consent"><input name="consent" type="checkbox" value="yes" required /> <span>I want to receive Approaching Infinity Notes by email. I can unsubscribe at any time.</span></label>
      <div class="form-trap" aria-hidden="true"><label for="newsletter-website-check">Leave this blank</label><input id="newsletter-website-check" name="website_check" tabindex="-1" autocomplete="off" /></div>
      <button class="btn btn-red" type="submit">{config.review ? 'Test newsletter signup' : 'Request subscription'}</button>
    </form>
    <p class="form-help">Look for the provider’s confirmation instructions after signing up. A request is not a confirmed subscription. If the request fails, return here to retry. <a href="/privacy/">Privacy notice</a>.</p>
  </> : <div class="newsletter-status"><p>Newsletter signup is not open yet. The episodes and free resources are available here while we prepare it.</p><a class="btn btn-ghost" href="/resources/">Explore free resources</a></div>}
  <p class="note">Voluntary signup. Contact inquiries and event participation never enroll you automatically.</p>
  <p><a class="text-link" href="/notes/">Read the notes archive</a></p>
</div></section>
