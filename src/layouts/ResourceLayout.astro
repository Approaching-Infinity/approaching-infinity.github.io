---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={`${frontmatter.title} — Approaching Infinity`} description={frontmatter.description}>
  <section class="page-shell"><div class="wrap"><article class="resource-document">
    <p class="resource-back ep-back"><a href="/resources/">All free resources</a></p>
    <div class="resource-actions"><button class="btn btn-ghost" type="button" id="print-resource">Print / save as PDF</button><a class="btn btn-ghost" href="/resources/bill-calendar-worksheet/">Blank worksheet</a></div>
    <div class="prose"><slot /></div>
  </article></div></section>
  <script>
    document.getElementById('print-resource')?.addEventListener('click', () => window.print());
    document.querySelectorAll('.resource-document table').forEach((table) => {
      const wrapper = document.createElement('div'); wrapper.className = 'table-scroll';
      wrapper.tabIndex = 0; wrapper.setAttribute('role', 'region');
      wrapper.setAttribute('aria-label', 'Scrollable resource table');
      table.before(wrapper); wrapper.append(table);
    });
  </script>
</Layout>
