---
import Layout from '../layouts/Layout.astro';
import { siteSupport } from '../config/site';

export function getStaticPaths() {
  const { visible, checkoutUrl, review } = siteSupport();
  return visible ? [{ params: { reviewPage: 'support' }, props: { checkoutUrl, review } }] : [];
}

const { checkoutUrl, review } = Astro.props;
---
<Layout title="Support the show — Approaching Infinity" description="Leave a one-time tip for the Approaching Infinity podcast and see how listener support is used." noindex={review}>
  <section class="page-shell">
    <div class="wrap">
      <div class="page-heading">
        <h1>Support the show.</h1>
        <p>Enjoyed an episode? Leave a one-time tip for the published Approaching Infinity podcast.</p>
      </div>

      <div class="prose">
        {review && <p>{checkoutUrl ? 'Test checkout. Use a Stripe test card. No real money moves.' : 'Payments are not open.'}</p>}
        <p>Tips are paid to <strong>Approaching Infinity Group LLC</strong>. No charitable tax deduction applies.</p>
        <p>Tips help cover editing, captions, transcripts and other costs of producing the podcast and free educational resources.</p>
        <p><a class="text-link" href="#use-of-support">How we use listener support</a></p>
        {checkoutUrl && <p><a class="btn btn-red checkout-link" href={checkoutUrl}>{review ? 'Continue to Stripe test checkout' : 'Continue to Stripe'}</a></p>}
        <p>For payment or refund questions, email <a href="mailto:service@limitlesslp.com">service@limitlesslp.com</a>. See how we handle <a href="/privacy/#payments">payment information</a>.</p>

        <h2 id="use-of-support">How we use listener support</h2>
        <dl class="mission-areas">
          <div><dt>Ending poverty</dt><dd>Conversations and guides about expanding economic opportunity.</dd></div>
          <div><dt>Veteran initiatives</dt><dd>Episodes and practical resources for life after military service.</dd></div>
          <div><dt>Financial literacy</dt><dd>Plain-language explainers and free learning resources.</dd></div>
        </dl>

        <h2>Quarterly listener support reports</h2>
        <p>After the first reporting period, we’ll publish gross tips, refunds, fees and disputes, and net listener support. Each report will show spending by mission area, shared production costs, opening and closing unspent support, and links to the work published.</p>
        <p>We’ll reconcile totals to Stripe activity and the LLC’s books, date any corrections, and keep individual payment details private.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .checkout-link { min-height: 44px; }
  .checkout-link:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
  #use-of-support { scroll-margin-top: 5.5rem; }
  .mission-areas { margin: 1rem 0; }
  .mission-areas div { display: grid; grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); gap: .25rem 1rem; padding-block: .65rem; border-top: 1px solid var(--line); }
  .mission-areas dt { font-weight: 700; color: var(--text); }
  .mission-areas dd { margin: 0; }
  @media (max-width: 500px) { .mission-areas div { grid-template-columns: 1fr; } }
</style>
