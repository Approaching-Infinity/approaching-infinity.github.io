---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { resolveEpisodeVisuals } from '../../lib/episode-visuals';
import { siteSupport } from '../../config/site';
import { listeningHub, listeningPlatforms, youtubeVideoId } from '../../data/platforms.mjs';

export async function getStaticPaths() {
  const eps = await getCollection('episodes');
  return eps.map((ep) => ({ params: { slug: ep.id }, props: { ep } }));
}

const { ep } = Astro.props;
const { Content } = await render(ep);
const d = ep.data;
const showSupport = siteSupport().visible && !d.guestAppearance;
const showArt = d.guestAppearance ? (await resolveEpisodeVisuals(d.episodeVisuals))[0] : undefined;
const dateStr = d.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const pageTitle = `${d.title} — Approaching Infinity`;
const num = d.bonus ? '★' : String(d.episodeNumber).padStart(2, '0');

const appleEmbed = d.appleUrl ? d.appleUrl.replace('podcasts.apple.com', 'embed.podcasts.apple.com') : null;
const spotifyEmbed = d.spotifyEpisodeId
  ? `https://open.spotify.com/embed/episode/${d.spotifyEpisodeId}`
  : d.spotifyUrl
    ? d.spotifyUrl.replace('open.spotify.com/', 'open.spotify.com/embed/')
    : null;
const videoId = youtubeVideoId(d.youtubeUrl) ?? d.youtubeId;
const ytEmbed = videoId ? 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1' : null;

const tabs = [];
if (ytEmbed) tabs.push({ key: 'watch', label: 'Watch', kind: 'video', src: ytEmbed });
if (d.audioUrl) tabs.push({ key: 'listen', label: 'Listen', kind: 'native', src: d.audioUrl });
if (appleEmbed) tabs.push({ key: 'apple', label: 'Apple', kind: 'frame', src: appleEmbed, h: 175 });
if (spotifyEmbed) tabs.push({ key: 'spotify', label: 'Spotify', kind: 'frame', src: spotifyEmbed, h: 152 });
const defKey = tabs.length ? tabs[0].key : null;
const episodeLinks: Record<string, string | undefined> = {
  apple: d.appleUrl,
  amazon: d.amazonUrl,
  spotify: d.spotifyEpisodeId ? `https://open.spotify.com/episode/${d.spotifyEpisodeId}` : d.spotifyUrl,
  youtube: d.youtubeUrl ?? (d.youtubeId ? `https://www.youtube.com/watch?v=${d.youtubeId}` : undefined),
};
const platforms = listeningPlatforms.flatMap(platform => {
  const episodeUrl = episodeLinks[platform.id];
  const direct = Boolean(episodeUrl && episodeUrl !== platform.url);
  if (platform.id === 'youtube' && !direct) return [];
  return [{ ...platform, href: episodeUrl ?? platform.url, label: platform.name + (direct ? '' : ' show') }];
});
---
<Layout title={pageTitle} description={d.description}>
  <article class="ep-page wrap">
    <a class="ep-back reveal" href="/episodes/">&larr; All episodes</a>

    <header class="ep-hero reveal">
      <div class="ep-num-ghost" aria-hidden="true">{num}</div>
      <span class="eyebrow">{d.bonus ? 'Bonus episode' : `Episode ${d.episodeNumber}`} &middot; {dateStr}{d.duration ? ` · ${d.duration}` : ''}</span>
      <h1>{d.title}</h1>
      {d.guestAppearance ? <p class="ep-hero-guest">Justin featured on <a href={d.guestAppearance.url} target="_blank" rel="noopener">{d.guestAppearance.show}</a> · hosted by {d.guestAppearance.host}</p> : d.guest && <p class="ep-hero-guest">with {d.guest}</p>}
    </header>

    <div class="player-tabs reveal" data-player>
      <nav class="episode-platforms" aria-labelledby="episode-platforms-label">
        <span id="episode-platforms-label">Follow the show</span>
        <ul>
          {platforms.map(platform => (
            <li>
              <a href={platform.href} target="_blank" rel="noopener"
                aria-label={`${platform.label} (opens in a new tab)`}>
                <img src={platform.icon} width="20" height="20" alt="" />
                <span>{platform.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {tabs.length > 0 && (
        <>
          {tabs.length > 1 && (
            <div class="tab-bar" role="tablist" aria-label="Choose a player">
              {tabs.map((t) => (
                <button
                  class:list={['tab', { 'is-active': t.key === defKey }]}
                  data-tab={t.key}
                  role="tab"
                  type="button"
                  aria-selected={t.key === defKey ? 'true' : 'false'}>{t.label}</button>
              ))}
            </div>
          )}
          <div class="tab-panels">
            {tabs.map((t) => (
              <div
                class:list={['tab-panel', t.kind === 'video' && 'player-16x9', { 'is-active': t.key === defKey }]}
                data-panel={t.key}>
                {t.kind === 'native' ? (
                  <div class="audio-inline">
                    {(showArt || d.artwork) && <img class="player-art" src={showArt?.image.src ?? d.artwork} alt={showArt?.alt ?? ''} width="88" height="88" loading="lazy" />}
                    <div class="player-audio-main">
                      <span class="eyebrow">{d.bonus ? 'Bonus' : `Episode ${d.episodeNumber}`}</span>
                      <audio class="ep-audio" controls preload="none" src={t.src}>Your browser does not support the audio element.</audio>
                    </div>
                  </div>
                ) : t.kind === 'video' ? (
                  <button type="button" class="video-poster" data-play-video aria-label={'Play video: ' + d.title}>
                    <img src={'https://i.ytimg.com/vi/' + videoId + '/hqdefault.jpg'} alt="" width="480" height="360" />
                    <span class="video-play-icon"><img src="/icons/play-fill.svg" alt="" width="26" height="26" /></span>
                  </button>
                  <iframe
                    data-src={t.src}
                    title={d.title}
                    hidden
                    allow="autoplay; encrypted-media; picture-in-picture"
                    allowfullscreen></iframe>
                ) : (
                  <iframe
                    src={t.key === defKey ? t.src : undefined}
                    data-src={t.src}
                    title={`${d.title} — ${t.label}`}
                    loading="lazy"
                    height={t.h}
                    style="width:100%;border:0;display:block"
                    allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
                )}
              </div>
            ))}
          </div>
        </>
      )}
    </div>

    <div class="prose episode-show-notes">
      <Content />
    </div>

    {showSupport && <section class="episode-tip" aria-labelledby="episode-tip-title">
      <h2 id="episode-tip-title">Enjoyed this episode?</h2>
      <p>Leave a one-time tip for the conversation you just heard.</p>
      <a class="btn btn-red" href="/support/">Leave a one-time tip <span aria-hidden="true">&rarr;</span></a>
    </section>}

    <div class="ep-foot reveal">
      <a class="btn btn-ghost" href="/episodes/">&larr; All episodes</a>
      <a class="btn btn-red" href={listeningHub}>Listen everywhere</a>
    </div>
  </article>
</Layout>

<style>
  .episode-platforms {
    display: flex;
    align-items: center;
    gap: .35rem 1.2rem;
    flex-wrap: wrap;
    padding: .65rem clamp(1.1rem, 2.5vw, 1.6rem);
  }
  .episode-platforms:has(+ .tab-bar, + .tab-panels) { border-bottom: 1px solid var(--line); }
  #episode-platforms-label {
    color: var(--muted);
    font: .72rem/1.4 var(--mono);
    text-transform: uppercase;
    letter-spacing: .15em;
  }
  .episode-platforms ul {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .episode-platforms a {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 44px;
    padding: .25rem .6rem;
    color: var(--text);
    font-size: .83rem;
    font-weight: 600;
  }
  .episode-platforms a:hover { background: var(--surface-2); }
  .episode-platforms img { width: 20px; height: 20px; object-fit: contain; }
  .episode-platforms img[src$="applepodcasts.svg"] { border-radius: 4px; background: #fff; }
  .video-poster {
    display: grid;
    place-items: center;
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
  }
  .video-poster[hidden], .player-16x9 iframe[hidden] { display: none; }
  .video-poster > img { width: 100%; height: 100%; object-fit: cover; }
  .video-play-icon {
    position: absolute;
    display: grid;
    place-items: center;
    width: 68px;
    height: 52px;
    border-radius: 12px;
    background: var(--red);
  }
  .video-poster:hover .video-play-icon { filter: brightness(1.18); }
  .video-poster:focus-visible { outline-offset: -5px; }
  .episode-show-notes :global(li) { margin: .18rem 0; }
  @media (max-width: 600px) {
    .episode-platforms { padding-block: .8rem; }
    .episode-platforms ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
    .episode-platforms a { display: flex; padding-inline: .25rem; }
    .player-audio-main { width: 100%; }
  }
  .episode-tip { max-width: 68ch; margin: 2.5rem 0; padding: 1.1rem 1.2rem; background: var(--surface); border: 1px solid var(--line-strong); border-left: 3px solid var(--red); }
  .episode-tip h2 { font: 700 1.15rem/1.3 var(--body); text-transform: none; }
  .episode-tip p { color: var(--muted); margin: .3rem 0 .75rem; }
  .episode-tip a { min-height: 44px; }
  .episode-tip a:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
</style>

<script>
  document.querySelectorAll('[data-player]').forEach(function (player) {
    var tabs = player.querySelectorAll('.tab');
    var panels = player.querySelectorAll('.tab-panel');
    var poster = player.querySelector('[data-play-video]');
    var video = player.querySelector('.player-16x9 iframe');
    poster?.addEventListener('click', function () {
      if (!(poster instanceof HTMLButtonElement) || !(video instanceof HTMLIFrameElement) || !video.dataset.src) return;
      video.src = video.dataset.src;
      video.hidden = false;
      poster.hidden = true;
      video.focus();
    });
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var key = tab.getAttribute('data-tab');
        tabs.forEach(function (t) {
          var on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach(function (panel) {
          var on = panel.getAttribute('data-panel') === key;
          panel.classList.toggle('is-active', on);
          var frame = panel.querySelector('iframe');
          if (!on) {
            panel.querySelector('audio')?.pause();
            frame?.removeAttribute('src');
            if (frame && frame === video && poster instanceof HTMLButtonElement) {
              frame.hidden = true;
              poster.hidden = false;
            }
          } else if (frame && frame !== video && !frame.getAttribute('src') && frame.dataset.src) {
            frame.src = frame.dataset.src;
          }
        });
      });
    });
  });
</script>
