---
import Layout from '../../layouts/Layout.astro';
import { getEpisodesNewestFirst } from '../../lib/episodes';
import EpisodeRow from '../../components/EpisodeRow.astro';

const episodes = await getEpisodesNewestFirst();
---
<Layout
  title="Episodes — Approaching Infinity"
  description="Every episode of Approaching Infinity: conversations with founders, investors, operators and veterans on finance, technology, innovation and ideas put to work."
>
  <section class="ep-index wrap">
    <a class="ep-back reveal" href="/">&larr; Home</a>
    <header class="sec-head reveal">
      <span class="eyebrow">The conversations</span>
      <h1>All episodes</h1>
      <p>Conversations with founders, investors, operators and veterans about ideas put to work.</p>
    </header>
    <div class="ep-list">
      {episodes.map((ep) => (
        <EpisodeRow episode={ep} />
      ))}
    </div>
  </section>
</Layout>
