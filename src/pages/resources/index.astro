---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import EpisodeVisual from '../../components/EpisodeVisual.astro';
import { episodeResources } from '../../data/episode-resources';

const episodes = await getCollection('episodes');
const cards = episodeResources.map(card => {
  const episode = episodes.find(entry => entry.id === card.episodeId);
  if (!episode) throw new Error(`Resource card episode is missing: ${card.episodeId}`);
  return { ...card, episode };
});
---
<Layout title="Episode resources — Approaching Infinity" description="Keep learning after the episode. Explore resources connected to conversations about financial literacy, veterans and creating opportunity.">
  <section class="page-shell resource-page">
    <div class="wrap">
      <div class="page-heading">
        <span class="eyebrow">From the conversation</span>
        <h1>Keep the idea moving.</h1>
        <p>Start with a conversation. Explore the idea behind it, then find a useful next step across our three mission areas.</p>
      </div>
      <div class="learning-grid">
        {cards.map(card => (
          <article class="learning-card">
            <p class="learning-pillar">{card.pillar}</p>
            <div class="learning-guest">
              <EpisodeVisual visuals={card.episode.data.episodeVisuals} />
              <div>
                <p class="learning-episode-number">{card.episode.data.bonus ? 'Bonus conversation' : `Episode ${card.episode.data.episodeNumber}`}</p>
                {card.episode.data.guest && <p class="learning-guest-name">{card.episode.data.guest}</p>}
              </div>
            </div>
            <h2><a href={`/episodes/${card.episode.id}/`}>{card.episode.data.title}</a></h2>
            <div class="learning-idea">
              <p class="learning-label">The idea to explore</p>
              <h3>{card.topic}</h3>
              <p>{card.idea}</p>
            </div>
            <a class="learning-episode-link" href={`/episodes/${card.episode.id}/`}>Listen to the conversation <span aria-hidden="true">↗</span></a>
            <div class="learning-links">
              <p class="learning-label">Take it further</p>
              {card.resources.map(resource => (
                <div class="learning-resource">
                  <p class="resource-origin">{resource.relationship === 'episode-notes' ? 'Linked in the episode notes' : 'Selected by Approaching Infinity'}</p>
                  <a href={resource.url} target="_blank" rel="noopener noreferrer">{resource.label}<span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a>
                  <p>{resource.description}</p>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
      <p class="learning-note">The guest’s conversation is the starting point. Resources labeled “Selected by Approaching Infinity” are our follow-up choices, not guest recommendations or endorsements. Links checked November 16, 2026. External programs set their own requirements; eligibility and outcomes are not guaranteed.</p>
      <aside class="practical-tool" aria-labelledby="tool-title">
        <div class="tool-copy">
          <p class="eyebrow">Try a practical tool</p>
          <h2 id="tool-title">A small step for your month ahead.</h2>
          <p>Put three bills and their planned payment dates on one page. Our free worksheet works privately in your browser or on paper. No signup needed.</p>
          <div class="tool-links">
            <a class="btn btn-ghost" href="/resources/bill-calendar-worksheet/">Open the bill worksheet</a>
            <a class="text-link" href="/resources/month-ahead/">Read the walkthrough</a>
          </div>
        </div>
        <a class="worksheet-visual" href="/resources/bill-calendar-worksheet/" aria-label="Open the free bill-calendar worksheet">
          <span class="visual-kicker">YOUR NEXT THREE BILLS</span>
          <span class="visual-row"><span>01 · Phone</span><span>Due by</span><span>Pay on</span></span>
          <span class="visual-row"><span>02 · Electricity</span><span>—</span><span>—</span></span>
          <span class="visual-row"><span>03 · Internet</span><span>—</span><span>—</span></span>
          <span class="visual-calendar" aria-hidden="true">{Array.from({length:14}, (_, i) => <span class:list={{marked:[2,6,10].includes(i)}}>{i+1}</span>)}</span>
          <span class="visual-footer">One month. One next step. <span aria-hidden="true">↗</span></span>
        </a>
      </aside>
    </div>
  </section>
</Layout>
<style>
  .resource-page { padding-top: 110px; }
  .page-heading { max-width: 760px; margin-bottom: 2.5rem; }
  .page-heading .eyebrow { margin-bottom: .9rem; }
  .page-heading h1 { font-size: clamp(2.8rem, 5.8vw, 4.5rem); margin-bottom: 1rem; }
  .learning-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
  .learning-card { border: 1px solid var(--line-strong); border-top: 3px solid var(--red); background: var(--surface); padding: 1.5rem; min-width: 0; display: flex; flex-direction: column; }
  .learning-pillar { font-family: var(--mono); color: var(--red-hot); font-size: .68rem; text-transform: uppercase; letter-spacing: .13em; margin-bottom: 1.4rem; }
  .learning-guest { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.2rem; }
  .learning-guest :global(.ep-portrait) { width: 80px; height: 80px; flex-shrink: 0; }
  .learning-episode-number, .learning-label { font-family: var(--mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
  .learning-guest-name { font-weight: 600; font-size: .95rem; margin-top: .25rem; }
  .learning-card h2 { font-size: clamp(1.6rem, 2.3vw, 2rem); line-height: 1.05; }
  .learning-card h2 a:hover { color: var(--red-hot); }
  .learning-card a:focus-visible, .worksheet-visual:focus-visible { outline: 2px solid var(--red-hot); outline-offset: 5px; }
  .learning-idea { margin-top: 1.6rem; }
  .learning-idea h3 { text-transform: none; font-family: var(--body); font-size: 1rem; line-height: 1.4; margin: .55rem 0; }
  .learning-idea > p:last-child { font-size: .9rem; color: var(--muted); line-height: 1.6; }
  .learning-episode-link { display: flex; justify-content: space-between; gap: .6rem; margin-top: 1.2rem; font-size: .85rem; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .learning-links { border-top: 1px solid var(--line-strong); margin-top: 1.6rem; padding-top: 1.2rem; }
  .learning-resource { margin-top: 1.2rem; }
  .resource-origin { font-size: .63rem; color: var(--muted); margin-bottom: .35rem; }
  .learning-resource a { font-weight: 600; font-size: .92rem; line-height: 1.45; text-decoration: underline; text-underline-offset: 3px; }
  .learning-resource > p:last-child { font-size: .82rem; line-height: 1.55; color: var(--muted); margin-top: .45rem; }
  .learning-note { color: var(--muted); font-size: .8rem; max-width: 100ch; margin-top: 1.2rem; }
  .practical-tool { display: grid; grid-template-columns: 1fr 280px; gap: 2.5rem; align-items: center; border-top: 1px solid var(--line-strong); margin-top: 3.5rem; padding-top: 2.5rem; }
  .tool-copy { max-width: 65ch; }
  .tool-copy h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); margin: .9rem 0; }
  .tool-copy > p:not(.eyebrow) { font-size: .95rem; color: var(--muted); }
  .tool-links { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.3rem; }
  .tool-links .text-link { font-size: .85rem; }
  .worksheet-visual { display: block; background: #f6f3f1; color: #171412; padding: 1.2rem; border-top: 4px solid var(--red); }
  .visual-kicker { font-family: var(--mono); font-size: .6rem; letter-spacing: .1em; display: block; margin-bottom: .8rem; }
  .visual-row { display: grid; grid-template-columns: 2fr 1fr 1fr; font-size: .6rem; border-bottom: 1px solid #ccc; gap: .4rem; padding: .5rem 0; }
  .visual-calendar { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; margin: .9rem 0; }
  .visual-calendar > span { border: 1px solid #d0ccca; min-height: 24px; font-size: .55rem; padding: .15rem; }
  .visual-calendar .marked { background: var(--red); color: #fff; border-color: var(--red); }
  .visual-footer { display: flex; justify-content: space-between; font-weight: 600; font-size: .7rem; }
  @media (max-width: 1050px) {
    .learning-grid { grid-template-columns: 1fr; }
    .learning-card { padding: 1.5rem; }
    .learning-card h2 { font-size: 2rem; max-width: 42ch; }
    .learning-idea { margin-top: 1.2rem; max-width: 85ch; }
    .learning-links { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
    .learning-links > .learning-label { grid-column: 1/-1; }
  }
  @media (max-width: 650px) {
    .resource-page { padding-top: 100px; }
    .learning-links, .practical-tool { grid-template-columns: 1fr; }
    .learning-card { padding: 1.2rem; }
    .learning-card h2 { font-size: 1.7rem; }
    .learning-pillar { margin-bottom: 1rem; }
    .practical-tool { gap: 1.5rem; }
    .worksheet-visual { max-width: 300px; }
  }
</style>
